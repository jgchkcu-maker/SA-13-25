# Never put real credentials into this example or commit .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SOURCE=@timetable_of_ak_sibsau
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Telegram forum topic:
TELEGRAM_THREAD_ID=
INITIAL_LOOKBACK_DAYS=3
ALBUM_SETTLE_SECONDS=120
STATE_BACKEND=local
# Required only for encrypted GitHub state:
STATE_ENCRYPTION_KEY=
STATE_FILE=state/state.json
# In Actions these are set by the workflow:
# STATE_BACKEND=github
# STATE_BRANCH=bot-state
# GITHUB_REPOSITORY=owner/repository
# GITHUB_TOKEN=automatic workflow token, never a committed personal token

